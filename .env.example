# =======================================================
# CLOCKIT: ZERO-LATENCY PUMP.FUN HFT SNIPER & COPY-TRADER
# =======================================================

# -------------------------------------------------------
# 1. TRITON YELLOWSTONE gRPC CONFIGURATION (PRIMARY STREAM)
# -------------------------------------------------------
# Your Triton Yellowstone gRPC endpoint (port 443 with TLS)
YELLOWSTONE_GRPC_URL=https://solana-grpc.triton.one:443

# Your Triton Secret Token from customers.triton.one
# (Sent via the 'x-token' gRPC metadata header)
YELLOWSTONE_X_TOKEN=YOUR_TRITON_SECRET_TOKEN_HERE

# -------------------------------------------------------
# 2. SOLANA STANDARD RPC (BLOCKHASH & ACCOUNTS)
# -------------------------------------------------------
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# -------------------------------------------------------
# 3. TRADER WALLET KEYPAIR
# -------------------------------------------------------
# Absolute path to your Solana CLI keypair JSON file or base58 private key
KEYPAIR_PATH=/home/rootkit/.config/solana/id.json

# -------------------------------------------------------
# 4. JITO MEV BLOCK ENGINE
# -------------------------------------------------------
# Choose the regional endpoint closest to your server location:
# - Frankfurt: https://frankfurt.mainnet.block-engine.jito.wtf/api/v1/bundles
# - Amsterdam: https://amsterdam.mainnet.block-engine.jito.wtf/api/v1/bundles
# - New York:  https://ny.mainnet.block-engine.jito.wtf/api/v1/bundles
# - Tokyo:     https://tokyo.mainnet.block-engine.jito.wtf/api/v1/bundles
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf/api/v1/bundles

# Minimum and Maximum Jito MEV Tips in Lamports (1 SOL = 1,000,000,000 lamports)
MIN_TIP_LAMPORTS=100000      # 0.0001 SOL
MAX_TIP_LAMPORTS=50000000    # 0.05 SOL

# Dynamic EV Tip Aggression Multiplier (e.g. 0.65 = 65% of EV given to validator)
TIP_AGGRESSION_FACTOR=0.65

# -------------------------------------------------------
# 5. COPY-TRADING & RISK MANAGEMENT
# -------------------------------------------------------
# SOL size per copy-trade
COPY_TRADE_AMOUNT_SOL=0.2

# Maximum SOL capital allocated to a single token
MAX_POSITION_SOL=2.0

# Max slippage tolerance in basis points (500 bps = 5%)
SLIPPAGE_BPS=500

# Automated Trailing Stop Loss (e.g. 0.15 = 15% trailing stop from peak price)
TRAILING_STOP_PCT=0.15

# Automated Take Profit multiplier (e.g. 2.5 = 250% / 2.5x of entry price)
TAKE_PROFIT_PCT=2.5

# Dev Dump Panic Front-run threshold (e.g. 0.20 = if dev sells >= 20% of their bag)
DEV_DUMP_THRESHOLD_PCT=0.20

# -------------------------------------------------------
# 6. TOP 20 PUMP.FUN LEADERBOARD TARGET WALLETS
# Comma-separated list of target trader wallets to copy-trade
# -------------------------------------------------------
TARGET_WALLETS=4y2T1N99Z1fK492N28Psp52qf8Dk7uGg8sK5zUqbdvE1,2k1c4GfX8n6D9sF6jZ8n5k4D8s7F6g5H4j3K2L1jaCf,BvApZ7m9N8b7V6c5X4z3A2s1D4f5G6h7J8k9L0mSruZ
