{
  "permissions": {
    "deny": [
      "Read(/.git/**)",
      "Edit(/.git/**)",
      "Read(**/.git/**)",
      "Edit(**/.git/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-git-dir.sh",
            "timeout": 10,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
